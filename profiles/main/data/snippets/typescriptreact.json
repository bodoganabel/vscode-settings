{
  // Place your snippets for typescriptreact here. Each snippet is defined under a snippet name and has a prefix, body and
  // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
  // same ids are connected.
  // Example:
  // "Print to console": {
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }

  "New React Functional Component": {
    "prefix": "rfc",
    "body": [
      "import React from 'react';",
      "",
      "import './$1.styles.scss';",
      "",
      "",
      "const $2 = ($3) => {",
      "",
      "    return (",
      "    <div className='$1'>",
      "        $4",
      "    </div>",
      "    );",
      "",
      "}",
      "",
      "",
      "export default $2;"
    ],
    "description": "Creates a new react functional component."
  },


  "New Div with className": {
    "prefix": "dc",
    "body": ["<div className='$1'>$2</div>"],
    "description": "Div with className"
  },

  "className": {
    "prefix": "cn",
    "body": ["className='$1'"],
    "description": "className=''"
  },

  "inlineStyle": {
    "prefix": "sty",
    "body": ["style={{$1:'$2', $3}}"],
    "description": "style={{}}"
  },

  "inlineStyle Element": {
    "prefix": "si",
    "body": [" $1:'$2',"],
    "description": "inline style item"
  },

  "arrow function": {
    "prefix": "af",
    "body": [" ($1) => {$2}"],
    "description": "creates an arrow function"
  },

  "const arrow function": {
    "prefix": "caf",
    "body": ["   const $1 = ($2) => {$3}"],
    "description": "declares an arrow function"
  },

  "arrow function with clg": {
    "prefix": "afc",
    "body": [" ($1) => {console.log($2)}"],
    "description": "arrow funct. w clg"
  },

  "br": {
    "prefix": "br",
    "body": ["<br/>"],
    "description": "<br/>"
  },

  "divcn": {
    "prefix": "divcn",
    "body": ["<div className='$1'>", "$2", "</div>"],
    "description": "Div with class name."
  },

  "?": {
    "prefix": "?",
    "body": ["($1)?($1):('$2')"],
    "description": "conditional (ternary) operator"
  },

  "center items with flex and justify items": {
    "prefix": "center",
    "body": ["display:'flex',  justifyContent:'center',"],
    "description": "center items with flex and justify items"
  },

  "Console log": {
    "prefix": "clg",
    "body": ["console.log($1);"],
    "description": "Console log"
  },

  "Double console log": {
    "prefix": "clgd",
    "body": ["console.log('$1:');","console.log($1);"],
    "description": "Double console log"
  },

  "Use state": {
    "prefix": "state",
    "body": ["const [$1, set$1] = useState($2);"],
    "description": "Adds useState element"
  },
  "Constant style": {
    "prefix": "cst",
    "body": [
      "const $1Style:any = {",
      " $2",
      "};"
    ],
    "description": "creates a style object"
  },
  "t() function": {
    "prefix": "tf",
    "body": [
      "const { t } = useTranslation();",
    ],
    "description": "imports t function from i18n"
  },
  "<Trans/>": {
    "prefix": "tran",
    "body": [
      "<Trans i18nKey={'$1'}/>",
    ],
    "description": "Adds a <Trans/> i18n component"
  },
  "<Trans>{{}}</Trans>": {
    "prefix": "trans",
    "body": [
      "<Trans i18nKey={'$1'}>{{$2}}</Trans>",
    ],
    "description": "Adds a <Trans>{{}}</Trans> i18n component"
  },
  "GraphQL query": {
    "prefix": "gqlq",
    "body": [
      "const $1 = gql`",
      " query $2(\\$id: ID!) {",
      "$3(id:\\$id) {",
      "$4",
      "}",
      "}",
      "`",
      "",
      "const { data: $2Data, loading: $2Loading, error: $2Error } = useQuery<$2,$2Variables>($1,{",
      " variables: {",
      "$3",
      "}",
      "});",
    ],
    "description": "creates a graphql query"
  },
  "GraphQL mutation": {
    "prefix": "gqlm",
    "body": [
      "const $1 = gql`",
      " mutation $2(\\$id: ID!) {",
      "$3(id:\\$id) {",
      "",
      "}",
      "}",
      "`;",
      "",
      "const [$2,{ data: $2Data, loading: $2Loading, error: $2Error }] = useMutation<$2,$2Variables>($1,{",
      "refetchQueries: [{query:$0}],",
      " variables: {",
      "$4",
      "}",
      "});",
    ],
    "description": "creates a graphql query"
  },
  "use GraphQL query": {
    "prefix": "useQuery",
    "body": [
      "const { data: $1Data, loading: $1Loading, error: $1Error } = useQuery<,>($2,{",
      " variables: {",
      "$3",
      "}",
      "});",
    ],
    "description": "creates graphql query usage"
  },
  "use GraphQL mutation": {
    "prefix": "useMutation",
    "body": [
      "const [$2,{ data: $2Data, loading: $2Loading, error: $2Error }] = useMutation<$2,$2Variables>($1,{",
      "refetchQueries: ['$0'],",
      " variables: {",
      "$3",
      "}",
      "});",
    ],
    "description": "creates graphql mutation usage"
  },
  
  "styled.div": {
    "prefix": "sd",
    "body": [
      "export const $1 = styled.$div`",
      "\t$0",
      "`;",
    ],
    "description": "imports gql"
  },

  
  "GraphQL import": {
    "prefix": "gqli",
    "body": [
      "import gql from 'graphql-tag';",
    ],
    "description": "imports gql"
  },
  "styled import": {
    "prefix": "styledi",
    "body": [
      "import styled from 'styled-components';",
    ],
    "description": "imports gql"
  }
}
