		"body": [
			"<script lang=\"ts\">", 
			"\timport { API, EHttpMethod } from \"$lib/api\";",
			"",
			"\tlet api = new API('$1',EHttpMethod.$2)",
			"</script>",
			"",
			"<Fetcher bind:api>",
			"\t<Button",
			"\t\ton:click={() => {",
			"\t\t\tapi.invoke({}, { onSuccess: () => {}, onError: (error) => {} });",
			"\t\t}}",
			"\t>",
			"\t\tSubmit",
			"\t</Button>",
			"</Fetcher>",
			"",
